#!/usr/bin/env bash
# =============================================================
#  OCP 노드 IP 설정 파일
#  설치 전 이 파일을 편집한 후 진행하세요.
#  모든 설치 스크립트는 이 파일을 source하여 실행됩니다.
#  사용법: source nodes-config.env
# =============================================================

# ── Bastion ──────────────────────────────────────────────────
BASTION_EXT_IP="10.1.10.51"       # ens33 (외부망, 10.x 대역)
BASTION_INT_IP="192.168.0.1"      # ens35 (내부망, 게이트웨이)
BASTION_EXT_NIC="ens33"
BASTION_INT_NIC="ens35"

# ── OCP 클러스터 노드 (192.168.0.x 내부망) ───────────────────
BOOTSTRAP_IP="192.168.0.10"
MASTER1_IP="192.168.0.11"
MASTER2_IP="192.168.0.12"
MASTER3_IP="192.168.0.13"
WORKER1_IP="192.168.0.14"
WORKER2_IP="192.168.0.15"
GPU_WORKER_IP="192.168.0.16"      # 5월 추가 예정

# ── 네트워크 공통 설정 ────────────────────────────────────────
INTERNAL_SUBNET="192.168.0.0/24"
INTERNAL_PREFIX="24"
GATEWAY="${BASTION_INT_IP}"       # 내부 노드의 기본 게이트웨이
DNS_SERVER="${BASTION_INT_IP}"    # 내부 노드의 DNS 서버

# ── OCP 클러스터 설정 ─────────────────────────────────────────
CLUSTER_NAME="ocp"
BASE_DOMAIN="cpf.com"
OCP_VERSION="stable-4.21.6"

# ── 내부 레지스트리 ───────────────────────────────────────────
REGISTRY_HOST="registry.ocp.cpf.com"
REGISTRY_PORT="5000"

# =============================================================
#  변경 이력
#  2026-04-16  초기 작성 — 이중 네트워크 분리 (외부 IP 절약)
# =============================================================
